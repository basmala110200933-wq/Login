<Window x:Class="login_Admin.AdminAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:login_Admin"
        mc:Ignorable="d"
        Title="AdminAdd" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel>

            <GroupBox Header="Add New Student" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="Student Name:" Margin="0,0,0,5"/>
                    <TextBox x:Name="newStudentName" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Username:" Margin="0,0,0,5"/>
                    <TextBox x:Name="newStudentUsername" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Password:" Margin="0,0,0,5"/>
                    <TextBox x:Name="newStudentPassword" Height="30" Margin="0,0,0,10"/>

                    <Button Content="Add Student" Background="#FF23B2DA" Foreground="White" BorderBrush="White" BorderThickness="4" Width="100" Height="30" Click="Button_Click"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Add New Course">
                <StackPanel Margin="10">
               <TextBlock Text="Course Name:" FontFamily="Comic Sans MS" Margin="0,0,0,5"/>
               <TextBox x:Name="newCourseName" Height="30" Margin="0,0,0,10"/>

                <Button Content="Add Course" FontFamily="Comic Sans MS" Background="#FF23B2DA" Foreground="White" BorderBrush="White" BorderThickness="3" Width="100" Height="30" Click="AddCourse_Click"/>
                </StackPanel>
                 </GroupBox>
              <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                <Button Content="Confirm"  Width="80" Height="35" Background="#FF23B2DA" BorderBrush="White" BorderThickness="4" Foreground="White" Margin="5" Click="Confirm_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
