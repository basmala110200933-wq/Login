<Window x:Class="login_Admin.AdminWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:login_Admin"
        mc:Ignorable="d"
        Title="AdminWPF" Height="450" Width="800">
    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="Admin" FontFamily="Comic Sans MS" Background="#FF007191" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
            <Button Width="120" Height="30" Background="Red" Foreground="White" Content="Logout" FontWeight="Bold" BorderBrush="White" BorderThickness="4" Margin="1,-70,-620,1" Click="Button1_Click"/>
            <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Student Grades" FontSize="16" FontFamily="Comic Sans MS"  Margin="0,0,0,10"/>
                        <DataGrid x:Name="gradesDataGrid" Height="120" AutoGenerateColumns="True"  IsReadOnly="True"/>
                <Button Content="Refresh" FontFamily="Comic Sans MS" FontStyle="Italic" BorderBrush="White" BorderThickness="3" Background="#FF23B2DA" Width="100" Height="30" Margin="-400,10,0,0" Click="Button_Click"/>
                <Button Content="Add" FontFamily="Comic Sans MS" FontStyle="Italic" BorderBrush="White" BorderThickness="3" Background="#FF23B2DA" Width="100" Height="30" Margin="0,-30,-300,0" Click="Button2_Click"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,15">
                <TextBlock Text="Students" FontSize="16" FontFamily="Comic Sans MS" Margin="0,0,0,10"/>
                <DataGrid x:Name="studentsDataGrid" Height="120" AutoGenerateColumns="True" IsReadOnly="True"/>
                <Button Content=" Students" Width="100" FontFamily="Comic Sans MS" FontStyle="Italic" Background="#FF23B2DA" BorderBrush="White" BorderThickness="4" Height="30" Margin="0,10,0,0" Click="Button_Click"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Courses List"  FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="coursesDataGrid" Height="120" AutoGenerateColumns="True" IsReadOnly="True"/>
                <Button Content="Refresh" Width="100" Height="30"  FontFamily="Comic Sans MS" FontStyle="Italic" Background="#FF23B2DA" BorderBrush="White" BorderThickness="4" Margin="0,10,0,0" Click="Button1_Click"/>
                    </StackPanel>
        </StackPanel>
            </Grid>
        </Window>